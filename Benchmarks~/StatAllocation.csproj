<!--
  할당 벤치마크. Runtime 소스를 그대로 컴파일해 돌린다.

  Unity 없이 도는 이유는 Runtime이 순수 C#이기 때문이고, 덕분에 CI에서
  라이선스 없이 매 푸시마다 실행할 수 있다. 측정 조건과 한계는 README.md 참고.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>StatAllocationBenchmark</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Runtime/**/*.cs" />
    <Compile Include="LegacyReflectionStat.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
