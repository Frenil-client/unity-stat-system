<!--
  Unity 없이 도는 테스트 프로젝트.

  Tests/ 의 소스를 그대로 컴파일한다. 사본이 아니라 같은 파일이므로
  Unity Test Runner에서 도는 것과 정확히 같은 테스트가 실행된다.

  StatAllocationTests.cs만 제외한다. Is.Not.AllocatingGCMemory()가
  UnityEngine.TestTools의 제약이라 Unity 밖에서는 컴파일되지 않는다.
  같은 성질은 Benchmarks~ 가 라이선스 없이, 수치까지 비교해 검증한다.

  NUnit은 Unity가 쓰는 3.x 계열로 맞춘다. 4.x는 Assert.AreEqual 같은
  classic 단언을 ClassicAssert로 옮겨서 같은 소스가 컴파일되지 않는다.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>StatSystem.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Runtime/**/*.cs" />
    <Compile Include="../Tests/*.cs" Exclude="../Tests/StatAllocationTests.cs" />
  </ItemGroup>

</Project>
